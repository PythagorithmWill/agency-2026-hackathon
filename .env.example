# Database — hackathon corpus on Render Postgres.
# Use the PRIMARY host (dpg-<id>-a.oregon-postgres.render.com). The read
# replica host (dpg-<id>-b.replica-cyan...) was retired by Render in 2026
# and now closes every TLS connection immediately; the app reports that as
# "data source unreachable". The app never writes (PROJECT-RULES R2), and
# longQuery() runs inside BEGIN READ ONLY as a guard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Database — failover (local Postgres loaded via .local-db/import.js)
DATABASE_URL_FAILOVER=postgresql://localhost:5432/agency26

# Database — dedicated writable instance for embedding storage (separate from
# the read-only hackathon DB; PROJECT-RULES R2 forbids writes to that one)
EMBEDDING_DATABASE_URL=postgresql://localhost:5432/pythagorithm_embeddings

# Embedding provider — primary
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large

# Embedding fallback chain
OPENAI_API_KEY=
COHERE_API_KEY=
BEDROCK_REGION=ca-central-1

# Anthropic API (failover for any synthesis the demo touches)
ANTHROPIC_API_KEY=

# Build identity
BUILD_COMMIT=
BUILD_TIMESTAMP=
PROOF_TOKEN_VERSION=1.0
