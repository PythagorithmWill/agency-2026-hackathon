# Database — primary (Render Postgres replica, read-only)
# Fill in from the hackathon-provided credentials. NEVER commit the real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Database — failover (local Postgres loaded via .local-db/import.js)
DATABASE_URL_FAILOVER=postgresql://localhost:5432/agency26

# LLM provider — "bedrock" (primary) or "anthropic_direct" (failover)
LLM_PROVIDER=bedrock

# AWS Bedrock (primary, used when LLM_PROVIDER=bedrock)
BEDROCK_REGION=ca-central-1
BEDROCK_MODEL_OPUS=anthropic.claude-opus-4-6-20250514-v1:0
BEDROCK_MODEL_SONNET=anthropic.claude-sonnet-4-20250514-v1:0

# Anthropic API direct (failover)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# Build identity (set at deploy time)
BUILD_COMMIT=
BUILD_TIMESTAMP=
PROOF_TOKEN_VERSION=1.0
